#!/usr/bin/env -S guestfish -f
# ============================================================================
# A5E 双槽刷机包 build-image —— 布局对齐 lubancat1（ophub）
# ----------------------------------------------------------------------------
#   p1  32768..294911     128M  boot    FAT   ← extlinux + vmlinuz + initrd + dtb
#                                                （lubancat1 的 BOOT 分区；radxa 原
#                                                 config 分区已并入，不再单列）
#   p2  294912..2258943   960M  rootfs  ext4  ← 槽 A 纯系统（kernel 已分离到 p1）
#
# 槽 B(p3, 960M) 与 shared(p4, rest) 由首启 uci-defaults 在线建立
# （等价 lubancat1 openwrt-tf 建 ROOTFS2/SHARED）。最终 4 分区，编号对齐。
# img 截断到 p2 末尾（~1.2G raw）。
#
# 输入（50 步按 build-image 引用名软链到工作目录）：
#   rootfs.tar   ← 纯系统 rootfs（40 步产出，不含 kernel/dtb）
#   boot-files/  ← 40 步产出: vmlinuz + initrd.img + dtb/sun55i-a527-cubie-a5e.dtb
#                  + extlinux.conf（root= 占位，本脚本注入 p2 UUID）
# ============================================================================

!echo "Image generation started at $(date)."
echo "Allocating image file..."
!rm -f "output_512.img"
disk-create "output_512.img" raw 10G
add-drive "output_512.img" format:raw discard:besteffort blocksize:512
run

echo "Creating partition table..."
part-init /dev/sda gpt
part-add /dev/sda primary 32768 294911
part-set-bootable /dev/sda 1 true
part-add /dev/sda primary 294912 2258943
part-set-gpt-type /dev/sda 1 C12A7328-F81F-11D2-BA4B-00A0C93EC93B
part-set-gpt-type /dev/sda 2 0FC63DAF-8483-4772-8E79-3D69D8477DE4
part-set-gpt-attributes /dev/sda 1 4

echo "Formatting partitions..."
mkfs vfat /dev/sda1 label:boot
mkfs ext4 /dev/sda2 label:rootfs

echo "Mounting partitions..."
mount /dev/sda2 /
mkdir-p /boot
mkdir-p /boot/extlinux
mount /dev/sda1 /boot

echo "Deploying rootfs..."
tar-in rootfs.tar / xattrs:true

echo "Deploying boot files (kernel/dtb initramfs to FAT boot partition)..."
copy-in ./boot-files/vmlinuz /boot/
copy-in ./boot-files/initrd.img /boot/
copy-in ./boot-files/dtb /boot/

echo "Copying content from rootfs..."
!mkdir -p "./temp_dir"
copy-out /etc/kernel/cmdline "./temp_dir"
!mkdir -p "./temp_dir/u-boot"
copy-out /usr/lib/u-boot/ "./temp_dir"

echo "Updating files with disk info..."
blkid /dev/sda1 | grep "^UUID:" | cut -d " " -f 2 | xargs printf "UUID=%s /boot vfat defaults,x-systemd.automount,fmask=0077,dmask=0077 0 2\n" > "./temp_dir/fstab"
blkid /dev/sda2 | grep "^UUID:" | cut -d " " -f 2 | xargs printf "UUID=%s / ext4 defaults 0 1\n" >> "./temp_dir/fstab"
blkid /dev/sda2 | grep "^UUID:" | cut -d " " -f 2 > "./temp_dir/rootfs_uuid"
!sed -i -E -e "s/([[:space:]]*root=[^[:space:]]*[[:space:]]*)/ /g" -e "s/(append[[:space:]]+)/append root=UUID=$(cat "./temp_dir/rootfs_uuid") /g" "./boot-files/extlinux.conf"
!sed -i -E -e "s/([[:space:]]*root=[^[:space:]]*[[:space:]]*)/ /g" -e "s/^/root=UUID=$(cat "./temp_dir/rootfs_uuid") /g" "./temp_dir/cmdline"
copy-in ./temp_dir/fstab /etc/
copy-in ./boot-files/extlinux.conf /boot/extlinux/
copy-in "./temp_dir/cmdline" /etc/kernel/

echo "Truncating image to rootfs end..."
unmount-all
sync
shutdown
!truncate "--size=$(( ( $(sgdisk -i 2 "output_512.img" | grep "Last sector:" | cut -d " " -f 3) + 34 ) * 512 ))" "output_512.img"

echo "Fixing partition table..."
!sgdisk -ge "output_512.img" > /dev/null 2>&1 || true

echo "Installing bootloader..."
shutdown
!chmod +x "./temp_dir/u-boot/radxa-cubie-a5e/setup.sh"
!"./temp_dir/u-boot/radxa-cubie-a5e/setup.sh" update_bootloader "output_512.img" 512 2> /dev/null

echo "Cleaning up..."
!rm -rf "./temp_dir"
!sync

echo "Deploy succeed!"
!echo "Image generation finished at $(date)."
