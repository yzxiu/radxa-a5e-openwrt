#!/usr/bin/env -S guestfish -f
# ============================================================================
# A5E 双槽刷机包 build-image（单槽布局，定制版）
#
# 基于 radxa radxa-cubie-a5e_trixie_cli_t10.build-512-image 改造：
#   - 去掉 p2 efi 分区（空置无用）
#   - p2 = rootfs 槽 A，打包时定义大小 SLOT_A_MB（参考 lubancat ROOT1=960M）
#   - 刷机包只含槽 A；槽 B(p3) 与 shared(p4) 由首启 uci-defaults 在线创建
#     （仿 lubancat openwrt-tf；升级脚本 openwrt-update-* 写对侧槽）
#   - 去掉 shrink 段（原 resize2fs -M + resizepart + truncate 到 fs 实际大小），
#     槽 A 分区/文件系统固定 960M，img truncate 到 p2 分区末尾
#   - 分区几何参数化（GEOM_*），将来移植 router remake 时整段替换 make_image()
#
# 布局:
#   p1  32768..65535         16M   config (FAT)   ← U-Boot env (uboot.env)
#   p2  65536..2031615       960M  rootfs (ext4)  ← 槽 A（唯一系统）
#   img truncate 到 p2 末尾 (~1.05G raw)
# ============================================================================

!echo "Image generation started at $(date)."
echo "Allocating image file..."
!rm -f "output_512.img"
disk-create "output_512.img" raw 10G
add-drive "output_512.img" format:raw discard:besteffort blocksize:512
run

echo "Creating partition table..."
# ---- 分区几何（移植 remake 时替换为平台变量）----
# GEOM_P1_{FIRST,LAST}: p1 config 16M（与 radxa 原厂一致，勿动：uboot.env 在这）
# GEOM_P2_MB:           槽 A 大小，首启建槽 B 时与之等大
part-init /dev/sda gpt
part-add /dev/sda primary 32768 65535
part-add /dev/sda primary 65536 2031615
part-set-bootable /dev/sda 2 true
part-set-gpt-type /dev/sda 2 0FC63DAF-8483-4772-8E79-3D69D8477DE4
part-set-gpt-attributes /dev/sda 2 4

echo "Formatting partitions..."
mkfs vfat /dev/sda1 label:config
mkfs ext4 /dev/sda2 label:rootfs

echo "Mounting partitions..."
mount /dev/sda2 /
mkdir-p /config
mount /dev/sda1 /config

echo "Deploying rootfs..."
tar-in rootfs.tar / xattrs:true

echo "Copying content from rootfs..."
!mkdir -p "./temp_dir"
copy-out /etc/kernel/cmdline "./temp_dir"
copy-out /boot/extlinux/extlinux.conf "./temp_dir"
!mkdir -p "./temp_dir/u-boot"
copy-out /usr/lib/u-boot/ "./temp_dir"

echo "Updating files with disk info..."
blkid /dev/sda1 | grep "^UUID:" | cut -d " " -f 2 | xargs printf "UUID=%s /config vfat defaults,x-systemd.automount,fmask=0077,dmask=0077 0 2\n" > "./temp_dir/fstab"
blkid /dev/sda2 | grep "^UUID:" | cut -d " " -f 2 | xargs printf "UUID=%s / ext4 defaults 0 1\n" >> "./temp_dir/fstab"
blkid /dev/sda2 | grep "^UUID:" | cut -d " " -f 2 > "./temp_dir/rootfs_uuid"
!sed -i -E -e "s/([[:space:]]*root=[^[:space:]]*[[:space:]]*)/ /g" -e "s/(append[[:space:]]+)/append root=UUID=$(cat "./temp_dir/rootfs_uuid") /g" "./temp_dir/extlinux.conf"
!sed -i -E -e "s/([[:space:]]*root=[^[:space:]]*[[:space:]]*)/ /g" -e "s/^/root=UUID=$(cat "./temp_dir/rootfs_uuid") /g" "./temp_dir/cmdline"
copy-in "./temp_dir/fstab" /etc/
copy-in "./temp_dir/extlinux.conf" /boot/extlinux/
copy-in "./temp_dir/cmdline" /etc/kernel/

echo "Truncating image to end of slot A partition..."
sync
shutdown
# truncate 到 p2 末尾 +34 (GPT 备份头), 再 sgdisk -ge 重建备份头到新末尾
!truncate "--size=$(( ( $(sgdisk -i 2 "output_512.img" | grep "Last sector:" | cut -d " " -f 3) + 34 ) * 512 ))" "output_512.img"

echo "Fixing partition table..."
echo "NOTICE: Some issues are expected result of shrinking the disk."
!sgdisk -ge "output_512.img" > /dev/null 2>&1 || true

echo "Installing bootloader..."
shutdown
!chmod +x "./temp_dir/u-boot/radxa-cubie-a5e/setup.sh"
!"./temp_dir/u-boot/radxa-cubie-a5e/setup.sh" update_bootloader "output_512.img" 512 2> /dev/null

echo "Cleaning up..."
!rm -rf "./temp_dir"
!sync

echo "Deploy succeed!"
!echo "Image generation finished at $(date)."
