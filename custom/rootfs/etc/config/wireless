# 预置无线配置（板载 AIC8800D80，SDIO，单射频双频）
#
# ── 频段能力（板上 `iw phy phy0 info` 实测）─────────────────────────────
# Band 1(2.4G) + Band 2(5G) 都有；5G 覆盖信道 36–165（各 20 dBm）；
# HE PHY Capabilities 含 80MHz、HE Iftypes 含 AP；VHT 最高 390 Mbps（= 2 流 × 195，2×2）。
# 但只暴露 **1 个 phy** → 单射频，**2.4G 与 5G 不能同时开**，只能二选一。
# 默认选 5G/HE80（吞吐远高于 2.4G/HT20）。想改回 2.4G：
#   band '2g' / channel '6' / htmode 'HT20'
#
# ── ⚠ 故意不设 `option country` ────────────────────────────────────────
# 本驱动 `rwnx_mod_params.c` 里 `COMMON_PARAM(custregd, true, true)` 默认为真
# （上游 MODULE_PARM_DESC 写的 "Default: 0" 是过时的），phy0 会被打上
# `REGULATORY_WIPHY_SELF_MANAGED`，用自己的 permissive regdomain：
#   $ iw reg get
#   phy#0 (self-managed)
#   country 00: DFS-UNSET          ← 设了 country 也不会变成 CN
# 而 hostapd 只要看到 `country_code=`，就会进 `COUNTRY_UPDATE` 状态等内核的
# REG_CHANGE 事件；self-managed 的 phy 不会给出它期待的那个事件 → **等 1 秒超时**：
#   hostapd: phy0-ap0: interface state UNINITIALIZED->COUNTRY_UPDATE
#   hostapd: phy0-ap0: AP-DISABLED
#   hostapd: hostapd_free_hapd_data: Interface phy0-ap0 wasn't started
# 实测：去掉 country 后同一份配置直接 `UNINITIALIZED->ENABLED` + `AP-ENABLED`。
# 也就是说 **country 在这块板上有害无益**（既没生效，又引入 1 秒竞态）。
#
# `country_ie='0'` / `doth='0'` 是第二道保险：
#   hostapd.sh:158 `set_default country_ie 1`、:160 `set_default doth 1`，
#   于是默认会发 `ieee80211d=1` 和（5G 时）`ieee80211h=1`。
#   若只关 country_ie 而留着 doth，hostapd 会直接拒绝配置：
#     "Cannot enable IEEE 802.11h without IEEE 802.11d enabled" → add_iface failed
#   两个必须一起关。（若将来有人把 country 加回来，这两项至少能避免这个硬错误。）
#
# ── ⚠ AP+STA 同开还需要 patches/70 ─────────────────────────────────────
# `common.uc` 的 `find_reusable_wdev()` 会把 operstate=="down" 的接口当空闲件
# 改名复用，而刚启用的 AP 在网桥端口 settling 期间 operstate 恰好是 down
# → 被改名成 sta0，AP 凭空消失（dmesg: `phy0-sta0: renamed from phy0-ap0 (while UP)`）。
# 单开 AP 不受影响；AP+STA 同开必现。补丁见 `patches/70-wdev-reusable-wdev-fix.sh`。
#
# ── 信道选择 ───────────────────────────────────────────────────────────
# 36 是**非 DFS** 信道，起来最快最稳；52–144 需要雷达检测（60s CAC）。
#
# ── option path 必须与实际 SDIO 拓扑一致（板上核对过）──────────────────
#   platform/soc@3000000/4021000.sdmmc/mmc_host/mmc2/mmc2:390b/mmc2:390b:1
#
# ⚠ 出厂默认是开放 AP（encryption none，SSID=ImmortalWrt）。首次上线请立即在
#   LuCI 或 `uci set wireless.default_radio0.encryption=psk2` 改成加密。

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@3000000/4021000.sdmmc/mmc_host/mmc2/mmc2:390b/mmc2:390b:1'
	option band '5g'
	option channel '36'
	option htmode 'HE80'
	option country_ie '0'
	option doth '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option ssid 'ImmortalWrt'
	option encryption 'none'
	option disabled '0'
